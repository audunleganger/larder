import kotlin.Boolean;

-- Nutrient values are per ref_amount of ref_unit (F-3). Both are optional until filled in.
CREATE TABLE food (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER NOT NULL REFERENCES app_user(id) ON DELETE CASCADE,
    name TEXT NOT NULL,
    name_norm TEXT NOT NULL,
    ref_amount REAL,
    ref_unit_id INTEGER REFERENCES quantity_unit(id) ON DELETE RESTRICT,
    notes TEXT,
    archived INTEGER AS Boolean NOT NULL DEFAULT 0,
    -- Composite foods (F-10): how much the ingredients make; NULL = their total weight.
    yield_amount REAL,
    yield_unit_id INTEGER REFERENCES quantity_unit(id) ON DELETE RESTRICT,
    -- Log a composite as one entry instead of one entry per ingredient.
    log_as_whole INTEGER AS Boolean NOT NULL DEFAULT 0,
    -- When it was made (ms since 1970); who made it is user_id. Admins can correct it.
    created_at INTEGER NOT NULL DEFAULT 0,
    -- Left out of the food picker when logging, but usable as an ingredient.
    ingredient_only INTEGER AS Boolean NOT NULL DEFAULT 0,
    UNIQUE (user_id, name_norm)
);

-- The ingredients of a composite food (F-10), in order. A food with ingredients is composite.
CREATE TABLE food_ingredient (
    food_id INTEGER NOT NULL REFERENCES food(id) ON DELETE CASCADE,
    position INTEGER NOT NULL,
    ingredient_id INTEGER NOT NULL REFERENCES food(id) ON DELETE RESTRICT,
    unit_id INTEGER NOT NULL REFERENCES quantity_unit(id) ON DELETE RESTRICT,
    quantity REAL NOT NULL CHECK (quantity > 0),
    PRIMARY KEY (food_id, position)
);

CREATE INDEX food_ingredient_ingredient ON food_ingredient(ingredient_id);

-- "1 <unit> = equals_amount <equals_unit>" (U-5). equals_* may be NULL while incomplete.
CREATE TABLE food_unit (
    food_id INTEGER NOT NULL REFERENCES food(id) ON DELETE CASCADE,
    unit_id INTEGER NOT NULL REFERENCES quantity_unit(id) ON DELETE RESTRICT,
    equals_amount REAL,
    equals_unit_id INTEGER REFERENCES quantity_unit(id) ON DELETE RESTRICT,
    PRIMARY KEY (food_id, unit_id)
);

-- The food's name in other languages (L-5); the main name is the fallback.
CREATE TABLE food_translation (
    food_id INTEGER NOT NULL REFERENCES food(id) ON DELETE CASCADE,
    locale TEXT NOT NULL,
    name TEXT NOT NULL,
    name_norm TEXT NOT NULL,
    PRIMARY KEY (food_id, locale)
);

-- A photo of the food (F-13): the image and a small square thumbnail, both resized by the client.
-- updated_at doubles as the version clients use to cache them.
CREATE TABLE food_image (
    food_id INTEGER PRIMARY KEY NOT NULL REFERENCES food(id) ON DELETE CASCADE,
    content_type TEXT NOT NULL,
    image BLOB NOT NULL,
    thumbnail BLOB NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TABLE food_nutrient (
    food_id INTEGER NOT NULL REFERENCES food(id) ON DELETE CASCADE,
    nutrient_id INTEGER NOT NULL REFERENCES nutrient(id) ON DELETE RESTRICT,
    amount REAL NOT NULL,
    PRIMARY KEY (food_id, nutrient_id)
);

selectFoods:
SELECT * FROM food WHERE user_id = ? ORDER BY name_norm;

selectFoodTranslations:
SELECT t.* FROM food_translation t JOIN food f ON f.id = t.food_id WHERE f.user_id = ?;

insertFoodTranslation:
INSERT INTO food_translation(food_id, locale, name, name_norm) VALUES (?, ?, ?, ?);

deleteFoodTranslations:
DELETE FROM food_translation WHERE food_id = ?;

selectFoodByNorm:
SELECT * FROM food WHERE user_id = ? AND name_norm = ?;

insertFood:
INSERT INTO food(user_id, name, name_norm, ref_amount, ref_unit_id, notes, archived, created_at, ingredient_only) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

updateFood:
UPDATE food SET name = ?, name_norm = ?, ref_amount = ?, ref_unit_id = ?, notes = ? WHERE id = ? AND user_id = ?;

setFoodCreatedAt:
UPDATE food SET created_at = ? WHERE id = ? AND user_id = ?;

setFoodIngredientOnly:
UPDATE food SET ingredient_only = ? WHERE id = ? AND user_id = ?;

setFoodArchived:
UPDATE food SET archived = ? WHERE id = ? AND user_id = ?;

deleteFood:
DELETE FROM food WHERE id = ? AND user_id = ?;

countFoodEntryRefs:
SELECT count(*) FROM entry WHERE food_id = ?;

countFoodIngredientRefs:
SELECT count(*) FROM food_ingredient WHERE ingredient_id = ?;

selectFoodIngredients:
SELECT fi.* FROM food_ingredient fi JOIN food f ON f.id = fi.food_id WHERE f.user_id = ? ORDER BY fi.food_id, fi.position;

insertFoodIngredient:
INSERT INTO food_ingredient(food_id, position, ingredient_id, unit_id, quantity) VALUES (?, ?, ?, ?, ?);

deleteFoodIngredients:
DELETE FROM food_ingredient WHERE food_id = ?;

updateFoodComposite:
UPDATE food SET yield_amount = ?, yield_unit_id = ?, log_as_whole = ? WHERE id = ? AND user_id = ?;

selectFoodUnits:
SELECT fu.* FROM food_unit fu JOIN food f ON f.id = fu.food_id WHERE f.user_id = ?;

insertFoodUnit:
INSERT OR REPLACE INTO food_unit(food_id, unit_id, equals_amount, equals_unit_id) VALUES (?, ?, ?, ?);

deleteFoodUnits:
DELETE FROM food_unit WHERE food_id = ?;

selectFoodNutrients:
SELECT fn.* FROM food_nutrient fn JOIN food f ON f.id = fn.food_id WHERE f.user_id = ?;

insertFoodNutrient:
INSERT OR REPLACE INTO food_nutrient(food_id, nutrient_id, amount) VALUES (?, ?, ?);

deleteFoodNutrients:
DELETE FROM food_nutrient WHERE food_id = ?;

selectFoodImageVersions:
SELECT i.food_id, i.updated_at FROM food_image i JOIN food f ON f.id = i.food_id WHERE f.user_id = ?;

selectFoodImage:
SELECT i.content_type, i.image, i.updated_at FROM food_image i JOIN food f ON f.id = i.food_id WHERE i.food_id = ? AND f.user_id = ?;

selectFoodThumbnail:
SELECT i.content_type, i.thumbnail, i.updated_at FROM food_image i JOIN food f ON f.id = i.food_id WHERE i.food_id = ? AND f.user_id = ?;

selectFoodImageFull:
SELECT i.* FROM food_image i JOIN food f ON f.id = i.food_id WHERE i.food_id = ? AND f.user_id = ?;

upsertFoodImage:
INSERT OR REPLACE INTO food_image(food_id, content_type, image, thumbnail, updated_at) VALUES (?, ?, ?, ?, ?);

deleteFoodImage:
DELETE FROM food_image WHERE food_id = ?;
