import kotlin.Boolean;

-- In Android local mode a single implicit user row owns all data.
CREATE TABLE app_user (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    username TEXT NOT NULL UNIQUE COLLATE NOCASE,
    password_hash TEXT,
    is_admin INTEGER AS Boolean NOT NULL DEFAULT 0,
    is_disabled INTEGER AS Boolean NOT NULL DEFAULT 0,
    locale TEXT,
    created_at INTEGER NOT NULL,
    -- The reference amount/unit of the food last set up; new foods start with it.
    food_ref_amount REAL,
    food_ref_unit_id INTEGER REFERENCES quantity_unit(id) ON DELETE SET NULL
);

countUsers:
SELECT count(*) FROM app_user;

countActiveAdmins:
SELECT count(*) FROM app_user WHERE is_admin = 1 AND is_disabled = 0;

insertUser:
INSERT INTO app_user(username, password_hash, is_admin, is_disabled, locale, created_at)
VALUES (?, ?, ?, 0, ?, ?);

lastInsertRowId:
SELECT last_insert_rowid();

selectById:
SELECT * FROM app_user WHERE id = ?;

selectByUsername:
SELECT * FROM app_user WHERE username = ?;

selectAll:
SELECT * FROM app_user ORDER BY username;

selectFirst:
SELECT * FROM app_user ORDER BY id LIMIT 1;

updatePassword:
UPDATE app_user SET password_hash = ? WHERE id = ?;

updateLocale:
UPDATE app_user SET locale = ? WHERE id = ?;

updateAdmin:
UPDATE app_user SET is_admin = ? WHERE id = ?;

updateDisabled:
UPDATE app_user SET is_disabled = ? WHERE id = ?;

selectFoodRefDefault:
SELECT food_ref_amount, food_ref_unit_id FROM app_user WHERE id = ?;

updateFoodRefDefault:
UPDATE app_user SET food_ref_amount = ?, food_ref_unit_id = ? WHERE id = ?;
