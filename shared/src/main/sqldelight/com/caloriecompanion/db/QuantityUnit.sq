import kotlin.Boolean;

-- Units are shared by all users of a server; each user picks which ones they see, and in which order
-- (shown_unit).
-- kind: 'mass' / 'volume' have a global base_factor (to g / ml); 'custom' is sized per food (U-2).
CREATE TABLE quantity_unit (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    -- The user who made the unit; only they and admins can change it.
    user_id INTEGER NOT NULL REFERENCES app_user(id) ON DELETE CASCADE,
    name TEXT NOT NULL,
    name_norm TEXT NOT NULL,
    kind TEXT NOT NULL CHECK (kind IN ('mass', 'volume', 'custom')),
    base_factor REAL,
    -- Unused since units can be hidden per user (schema 6); kept because older SQLite can't drop columns.
    archived INTEGER AS Boolean NOT NULL DEFAULT 0,
    -- Appended to the name when the quantity isn't 1 (U-8): "slice" + "s".
    plural_suffix TEXT NOT NULL DEFAULT '',
    -- One of the standard units every user starts with (U-3); only admins can change these.
    built_in INTEGER AS Boolean NOT NULL DEFAULT 0,
    -- When it was made (ms since 1970), and when and by whom it was last changed (null: never).
    -- Who made it is user_id. Admins can correct all four.
    created_at INTEGER NOT NULL DEFAULT 0,
    updated_at INTEGER,
    updated_by INTEGER REFERENCES app_user(id) ON DELETE SET NULL,
    UNIQUE (user_id, name_norm)
);

CREATE UNIQUE INDEX quantity_unit_name ON quantity_unit(name_norm);

-- The unit's name in other languages (L-5); the main name is the fallback.
CREATE TABLE unit_translation (
    unit_id INTEGER NOT NULL REFERENCES quantity_unit(id) ON DELETE CASCADE,
    locale TEXT NOT NULL,
    name TEXT NOT NULL,
    name_norm TEXT NOT NULL,
    plural_suffix TEXT NOT NULL DEFAULT '',
    PRIMARY KEY (unit_id, locale)
);

-- The units a user sees in lists and pickers. The rest are hidden for them, but still work where
-- they're already used.
CREATE TABLE shown_unit (
    user_id INTEGER NOT NULL REFERENCES app_user(id) ON DELETE CASCADE,
    unit_id INTEGER NOT NULL REFERENCES quantity_unit(id) ON DELETE CASCADE,
    -- The user's order; NULL until they set one, and then the units are in alphabetical order.
    sort_order INTEGER,
    PRIMARY KEY (user_id, unit_id)
);

selectUnits:
SELECT u.*, a.username AS owner_name, b.username AS updated_by_name FROM quantity_unit u
JOIN app_user a ON a.id = u.user_id
LEFT JOIN app_user b ON b.id = u.updated_by
ORDER BY u.name_norm;

selectShownUnits:
SELECT unit_id, sort_order FROM shown_unit WHERE user_id = ?;

selectBuiltInUnitIds:
SELECT id FROM quantity_unit WHERE built_in = 1;

insertUnit:
INSERT INTO quantity_unit(user_id, name, name_norm, kind, base_factor, plural_suffix, built_in, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

updateUnit:
UPDATE quantity_unit SET name = ?, name_norm = ?, kind = ?, base_factor = ?, plural_suffix = ? WHERE id = ?;

touchUnit:
UPDATE quantity_unit SET updated_at = ?, updated_by = ? WHERE id = ?;

setUnitMetadata:
UPDATE quantity_unit SET user_id = ?, created_at = ?, updated_at = ?, updated_by = ? WHERE id = ?;

selectUnitTranslations:
SELECT * FROM unit_translation;

insertUnitTranslation:
INSERT INTO unit_translation(unit_id, locale, name, name_norm, plural_suffix) VALUES (?, ?, ?, ?, ?);

deleteUnitTranslations:
DELETE FROM unit_translation WHERE unit_id = ?;

showUnit:
INSERT OR IGNORE INTO shown_unit(user_id, unit_id, sort_order) VALUES (?, ?, ?);

setShownUnitOrder:
UPDATE shown_unit SET sort_order = ? WHERE user_id = ? AND unit_id = ?;

resetShownUnitOrder:
UPDATE shown_unit SET sort_order = NULL WHERE user_id = ?;

maxShownUnitOrder:
SELECT max(sort_order) FROM shown_unit WHERE user_id = ?;

hideUnit:
DELETE FROM shown_unit WHERE user_id = ? AND unit_id = ?;

deleteUnit:
DELETE FROM quantity_unit WHERE id = ?;

countUnitEntryRefs:
SELECT count(*) FROM entry WHERE unit_id = :unitId;

countUnitFoodRefs:
SELECT count(DISTINCT f.id) FROM food f
LEFT JOIN food_unit fu ON fu.food_id = f.id
WHERE f.ref_unit_id = :unitId OR f.yield_unit_id = :unitId OR fu.unit_id = :unitId OR fu.equals_unit_id = :unitId
   OR f.id IN (SELECT food_id FROM food_ingredient WHERE unit_id = :unitId);

selectUnitDates:
SELECT DISTINCT local_date FROM entry WHERE user_id = ? AND unit_id = ? ORDER BY local_date DESC;
