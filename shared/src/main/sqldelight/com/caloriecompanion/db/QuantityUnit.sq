import kotlin.Boolean;

-- kind: 'mass' / 'volume' have a global base_factor (to g / ml); 'custom' is sized per food (U-2).
CREATE TABLE quantity_unit (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER NOT NULL REFERENCES app_user(id) ON DELETE CASCADE,
    name TEXT NOT NULL,
    name_norm TEXT NOT NULL,
    kind TEXT NOT NULL CHECK (kind IN ('mass', 'volume', 'custom')),
    base_factor REAL,
    archived INTEGER AS Boolean NOT NULL DEFAULT 0,
    -- Appended to the name when the quantity isn't 1 (U-8): "slice" + "s".
    plural_suffix TEXT NOT NULL DEFAULT '',
    UNIQUE (user_id, name_norm)
);

-- The unit's name in other languages (L-5); the main name is the fallback.
CREATE TABLE unit_translation (
    unit_id INTEGER NOT NULL REFERENCES quantity_unit(id) ON DELETE CASCADE,
    locale TEXT NOT NULL,
    name TEXT NOT NULL,
    name_norm TEXT NOT NULL,
    plural_suffix TEXT NOT NULL DEFAULT '',
    PRIMARY KEY (unit_id, locale)
);

selectUnits:
SELECT * FROM quantity_unit WHERE user_id = ? ORDER BY name_norm;

selectUnitByNorm:
SELECT * FROM quantity_unit WHERE user_id = ? AND name_norm = ?;

insertUnit:
INSERT INTO quantity_unit(user_id, name, name_norm, kind, base_factor, archived, plural_suffix) VALUES (?, ?, ?, ?, ?, ?, ?);

updateUnit:
UPDATE quantity_unit SET name = ?, name_norm = ?, kind = ?, base_factor = ?, plural_suffix = ? WHERE id = ? AND user_id = ?;

selectUnitTranslations:
SELECT t.* FROM unit_translation t JOIN quantity_unit u ON u.id = t.unit_id WHERE u.user_id = ?;

insertUnitTranslation:
INSERT INTO unit_translation(unit_id, locale, name, name_norm, plural_suffix) VALUES (?, ?, ?, ?, ?);

deleteUnitTranslations:
DELETE FROM unit_translation WHERE unit_id = ?;

setUnitArchived:
UPDATE quantity_unit SET archived = ? WHERE id = ? AND user_id = ?;

deleteUnit:
DELETE FROM quantity_unit WHERE id = ? AND user_id = ?;

countUnitEntryRefs:
SELECT count(*) FROM entry WHERE unit_id = :unitId;

countUnitFoodRefs:
SELECT count(DISTINCT f.id) FROM food f
LEFT JOIN food_unit fu ON fu.food_id = f.id
WHERE f.ref_unit_id = :unitId OR f.yield_unit_id = :unitId OR fu.unit_id = :unitId OR fu.equals_unit_id = :unitId
   OR f.id IN (SELECT food_id FROM food_ingredient WHERE unit_id = :unitId);

selectUnitDates:
SELECT DISTINCT local_date FROM entry WHERE user_id = ? AND unit_id = ? ORDER BY local_date DESC;
