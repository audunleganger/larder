-- v2 -> v3: names per language (L-5) and plural endings for units (U-8).

ALTER TABLE quantity_unit ADD COLUMN plural_suffix TEXT NOT NULL DEFAULT '';

CREATE TABLE unit_translation (
    unit_id INTEGER NOT NULL REFERENCES quantity_unit(id) ON DELETE CASCADE,
    locale TEXT NOT NULL,
    name TEXT NOT NULL,
    name_norm TEXT NOT NULL,
    plural_suffix TEXT NOT NULL DEFAULT '',
    PRIMARY KEY (unit_id, locale)
);

CREATE TABLE nutrient_translation (
    nutrient_id INTEGER NOT NULL REFERENCES nutrient(id) ON DELETE CASCADE,
    locale TEXT NOT NULL,
    name TEXT NOT NULL,
    name_norm TEXT NOT NULL,
    PRIMARY KEY (nutrient_id, locale)
);

CREATE TABLE food_translation (
    food_id INTEGER NOT NULL REFERENCES food(id) ON DELETE CASCADE,
    locale TEXT NOT NULL,
    name TEXT NOT NULL,
    name_norm TEXT NOT NULL,
    PRIMARY KEY (food_id, locale)
);

-- Plural endings for existing units: the built-in units get theirs; other custom units get the
-- default for their owner's language ("s", or Norwegian "er"/"r" after a final e); mass and volume
-- units (abbreviations such as g, ml) get none.
UPDATE quantity_unit SET plural_suffix = CASE
    WHEN name_norm IN ('serving', 'piece', 'cup', 'slice', 'glass', 'unit') THEN 's'
    WHEN name_norm IN ('porsjon', 'kopp') THEN 'er'
    WHEN name_norm IN ('stk', 'ts', 'ss', 'tsp', 'tbsp') THEN ''
    WHEN kind <> 'custom' THEN ''
    WHEN (SELECT lower(coalesce(locale, '')) FROM app_user WHERE app_user.id = quantity_unit.user_id) GLOB 'n[bon]*'
        THEN CASE WHEN name_norm GLOB '*e' THEN 'r' ELSE 'er' END
    ELSE 's'
END;

-- The built-in units and nutrients get their name in the other language, unless that name is
-- already taken by another item.

INSERT INTO unit_translation(unit_id, locale, name, name_norm, plural_suffix)
SELECT u.id, 'nb', 'ts', 'ts', '' FROM quantity_unit u
WHERE u.name_norm = 'tsp'
  AND u.user_id NOT IN (SELECT user_id FROM quantity_unit WHERE name_norm = 'ts');

INSERT INTO unit_translation(unit_id, locale, name, name_norm, plural_suffix)
SELECT u.id, 'en', 'tsp', 'tsp', '' FROM quantity_unit u
WHERE u.name_norm = 'ts'
  AND u.user_id NOT IN (SELECT user_id FROM quantity_unit WHERE name_norm = 'tsp');

