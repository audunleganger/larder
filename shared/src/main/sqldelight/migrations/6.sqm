-- v6 -> v7: when units, nutrients and foods were made, and when and by whom units and nutrients were
-- last changed. Who made one is the existing user_id. Existing items count as made at the upgrade;
-- they have no "last changed" yet.

ALTER TABLE quantity_unit ADD COLUMN created_at INTEGER NOT NULL DEFAULT 0;
ALTER TABLE quantity_unit ADD COLUMN updated_at INTEGER;
ALTER TABLE quantity_unit ADD COLUMN updated_by INTEGER REFERENCES app_user(id) ON DELETE SET NULL;

ALTER TABLE nutrient ADD COLUMN created_at INTEGER NOT NULL DEFAULT 0;
ALTER TABLE nutrient ADD COLUMN updated_at INTEGER;
ALTER TABLE nutrient ADD COLUMN updated_by INTEGER REFERENCES app_user(id) ON DELETE SET NULL;

ALTER TABLE food ADD COLUMN created_at INTEGER NOT NULL DEFAULT 0;

UPDATE quantity_unit SET created_at = CAST(strftime('%s', 'now') AS INTEGER) * 1000;
UPDATE nutrient SET created_at = CAST(strftime('%s', 'now') AS INTEGER) * 1000;
UPDATE food SET created_at = CAST(strftime('%s', 'now') AS INTEGER) * 1000;
